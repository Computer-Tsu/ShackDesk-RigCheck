<Window x:Class="RigCheck.Views.DiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RigCheck.Localization"
        Title="{loc:Str Discovery_Title}"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushForeground}">

    <!--
        The operator confirms which ports Find my radio may open before a
        single byte is sent. Ports that look like a rotator, amplifier, GPS,
        or Bluetooth link start unticked with the reason beside them; they
        can still be ticked by hand.
    -->

    <StackPanel Margin="24,20,24,16">

        <TextBlock Text="{loc:Str Discovery_Intro}" TextWrapping="Wrap"
                   FontSize="13" Margin="0,0,0,12" />

        <ItemsControl x:Name="PortList" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Foreground="{StaticResource BrushForeground}"
                              Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="13" />
                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                       Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="NoPortsText" Text="{loc:Str Discovery_NoPorts}" TextWrapping="Wrap"
                   Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,0,0,12"
                   Visibility="Collapsed" />

        <TextBlock Text="{loc:Str Discovery_Safety}" TextWrapping="Wrap"
                   Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StartButton" Content="{loc:Str Discovery_Start}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="110" IsDefault="True" Click="Start_Click" Margin="0,0,8,0" />
            <Button Content="{loc:Str Common_Cancel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
