<Window x:Class="RigCheck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RigCheck.ViewModels"
        xmlns:models="clr-namespace:RigCheck.Models"
        xmlns:loc="clr-namespace:RigCheck.Localization"
        Title="{Binding WindowTitle}"
        MinWidth="560" MinHeight="480"
        Width="{Binding Source={StaticResource Settings}, Path=Current.WindowWidth, Mode=TwoWay}"
        Height="{Binding Source={StaticResource Settings}, Path=Current.WindowHeight, Mode=TwoWay}"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushForeground}"
        Topmost="{Binding AlwaysOnTop}"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <DockPanel.LayoutTransform>
            <ScaleTransform ScaleX="{Binding ScaleFactor}" ScaleY="{Binding ScaleFactor}" />
        </DockPanel.LayoutTransform>

        <!-- ── Menu bar ── -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource MenuBarStyle}">
            <MenuItem Header="{loc:Str Menu_Settings}"
                      Style="{StaticResource TopMenuItemStyle}"
                      Click="Settings_Click" />
            <MenuItem Header="{loc:Str Menu_Help}" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Style="{StaticResource SubMenuItemStyle}"
                          Command="{Binding OpenHelpCommand}"
                          InputGestureText="F1">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <AccessText Text="{loc:Str Menu_HelpContents}" />
                            <TextBlock Style="{StaticResource ExternalLinkIconStyle}" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Style="{StaticResource SubMenuItemStyle}"
                          Command="{Binding OpenReleasesCommand}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <AccessText Text="{loc:Str Menu_HelpDownload}" />
                            <TextBlock Style="{StaticResource ExternalLinkIconStyle}" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Header="{loc:Str Menu_HelpViewData}"
                          Style="{StaticResource SubMenuItemStyle}"
                          Click="ViewData_Click" />
                <Separator />
                <MenuItem x:Name="AboutMenuItem"
                          Style="{StaticResource SubMenuItemStyle}"
                          Click="About_Click" />
            </MenuItem>
        </Menu>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- chrome bar (hidden by default) -->
            <RowDefinition Height="Auto" />   <!-- Hamlib status bar -->
            <RowDefinition Height="Auto" />   <!-- connection configuration -->
            <RowDefinition Height="*"    />   <!-- test results -->
            <RowDefinition Height="Auto" />   <!-- raw console (collapsible) -->
            <RowDefinition Height="Auto" />   <!-- action bar -->
            <RowDefinition Height="Auto" />   <!-- status strip -->
        </Grid.RowDefinitions>

        <!-- ── Chrome bar (hidden, revealed on click) ── -->
        <Border Grid.Row="0"
                Style="{StaticResource ChromeBarStyle}"
                Visibility="{Binding ChromeVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding WindowTitle}"
                           Style="{StaticResource ChromeTitleStyle}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="–" Style="{StaticResource ChromeButtonStyle}"
                            Command="{Binding ScaleDownCommand}" ToolTip="{loc:Str Main_ScaleDown}" />
                    <Button Content="+" Style="{StaticResource ChromeButtonStyle}"
                            Command="{Binding ScaleUpCommand}"   ToolTip="{loc:Str Main_ScaleUp}" />
                    <Button Content="⊡" Style="{StaticResource ChromeButtonStyle}"
                            Command="{Binding ScaleResetCommand}" ToolTip="{loc:Str Main_ScaleReset}" />
                    <CheckBox Content="{loc:Str Main_OnTop}" IsChecked="{Binding AlwaysOnTop}"
                              Style="{StaticResource ChromeCheckStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Hamlib status ── -->
        <Border Grid.Row="1" Style="{StaticResource HamlibStatusBarStyle}">
            <DockPanel>
                <Ellipse Width="8" Height="8" Margin="8,0,6,0"
                         Fill="{Binding IsHamlibAvailable, Converter={StaticResource BoolToStatusColor}}" />
                <TextBlock Text="{Binding HamlibStatus}"
                           Style="{StaticResource StatusTextStyle}" />
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource LinkButtonStyle}"
                        Visibility="{Binding IsHamlibMissing, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding OpenHamlibDownloadCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str Main_HowToInstall}" />
                        <TextBlock Style="{StaticResource ExternalLinkIconStyle}" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ── Connection configuration ── -->
        <GroupBox Grid.Row="2" Header="{loc:Str Main_Connection}" Style="{StaticResource GroupBoxStyle}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- preset selector -->
                    <RowDefinition Height="Auto" />   <!-- mode toggle -->
                    <RowDefinition Height="Auto" />   <!-- serial settings -->
                    <RowDefinition Height="Auto" />   <!-- advanced serial -->
                </Grid.RowDefinitions>

                <!-- Preset selector -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Label Content="{loc:Str Main_QuickPreset}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Connection.AvailablePresets}"
                              SelectedItem="{Binding Connection.SelectedPreset}"
                              DisplayMemberPath="Name"
                              Tag="{loc:Str Placeholder_ChooseRadio}"
                              Style="{StaticResource ComboBoxStyle}"
                              Width="240" />
                </DockPanel>

                <!-- Serial / rigctld toggle -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Content="{loc:Str Main_DirectSerial}"
                                 IsChecked="{Binding Connection.UseRigctld, Converter={StaticResource InverseBool}}"
                                 Style="{StaticResource RadioStyle}" Margin="0,0,16,0" />
                    <RadioButton Content="{loc:Str Main_Rigctld}"
                                 IsChecked="{Binding Connection.UseRigctld}"
                                 Style="{StaticResource RadioStyle}" />
                </StackPanel>

                <!-- Serial settings panel -->
                <Grid Grid.Row="2"
                      Visibility="{Binding Connection.UseRigctld, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- COM port -->
                    <Label Grid.Column="0" Content="{loc:Str Main_Port}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Connection.AvailablePorts}"
                              SelectedItem="{Binding Connection.SelectedPort}"
                              DisplayMemberPath="DisplayName"
                              Tag="{loc:Str Placeholder_SelectPort}"
                              Style="{StaticResource ComboBoxStyle}" MinWidth="160" />
                    <Button Grid.Column="2" Content="↻" ToolTip="{loc:Str Main_RefreshPorts}"
                            Command="{Binding Connection.RefreshPortsCommand}"
                            Style="{StaticResource IconButtonStyle}" Margin="4,0,16,0" />

                    <!-- Baud rate -->
                    <Label Grid.Column="3" Content="{loc:Str Main_Baud}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding Connection.BaudRates}"
                              SelectedValuePath="Value" DisplayMemberPath="Label"
                              SelectedValue="{Binding Connection.BaudRate}"
                              Style="{StaticResource ComboBoxStyle}" MinWidth="120" />
                </Grid>

                <!-- rigctld panel -->
                <Grid Grid.Row="2"
                      Visibility="{Binding Connection.UseRigctld, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{loc:Str Main_Host}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Column="1" Text="{Binding Connection.RigctldHost}"
                             Style="{StaticResource TextBoxStyle}" />
                    <Label Grid.Column="2" Content="{loc:Str Main_Port}" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0" />
                    <TextBox Grid.Column="3" Text="{Binding Connection.RigctldPort}"
                             Style="{StaticResource TextBoxStyle}" />
                </Grid>

                <!-- Advanced serial row (PTT, data bits, etc.) — collapsed by default -->
                <Expander Grid.Row="3" Header="{loc:Str Main_AdvancedSerial}"
                          Foreground="{StaticResource BrushMuted}" FontSize="11"
                          Visibility="{Binding Connection.UseRigctld, Converter={StaticResource InverseBoolToVisibility}}"
                          Margin="0,4,0,0">
                    <WrapPanel Margin="4,4,0,0">
                        <!-- Widths are minimums so translated labels can grow. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Label Content="{loc:Str Main_Ptt}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Connection.PttMethods}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding Connection.PttMethod}"
                                      Style="{StaticResource ComboBoxStyle}" MinWidth="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Label Content="{loc:Str Main_DataBits}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Connection.DataBitsOptions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding Connection.DataBits}"
                                      Style="{StaticResource ComboBoxStyle}" MinWidth="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Label Content="{loc:Str Main_Parity}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Connection.ParityOptions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding Connection.Parity}"
                                      Style="{StaticResource ComboBoxStyle}" MinWidth="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Label Content="{loc:Str Main_StopBits}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Connection.StopBitsOptions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding Connection.StopBits}"
                                      Style="{StaticResource ComboBoxStyle}" MinWidth="120" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{loc:Str Main_FlowControl}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Connection.FlowCtrlOptions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      SelectedValue="{Binding Connection.FlowControl}"
                                      Style="{StaticResource ComboBoxStyle}" MinWidth="120" />
                        </StackPanel>
                    </WrapPanel>
                </Expander>
            </Grid>
        </GroupBox>

        <!-- ── Test results ── -->
        <GroupBox Grid.Row="3" Header="{loc:Str Main_Results}" Style="{StaticResource GroupBoxStyle}">
            <DockPanel>
                <!-- Summary bar -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource SummaryBarStyle}"
                        Visibility="{Binding Results.HasResults, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Results.SummaryText}"
                               Style="{StaticResource SummaryTextStyle}" />
                </Border>

                <!-- Results document: read-only, selectable, Ctrl+A / Ctrl+C copy as
                     plain text. Built by ResultsDocumentBuilder in code-behind. -->
                <FlowDocumentScrollViewer x:Name="ResultsViewer"
                                          Style="{StaticResource ResultsViewerStyle}"
                                          IsSelectionEnabled="True"
                                          IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                    <FlowDocumentScrollViewer.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Copy"
                                        CanExecute="ResultsCopy_CanExecute"
                                        Executed="ResultsCopy_Executed" />
                    </FlowDocumentScrollViewer.CommandBindings>
                </FlowDocumentScrollViewer>
            </DockPanel>
        </GroupBox>

        <!-- ── Raw console (collapsible advanced panel) ── -->
        <Expander Grid.Row="4"
                  Header="{loc:Str Main_RawConsole}"
                  IsExpanded="{Binding RawConsoleVisible}"
                  Style="{StaticResource RawConsoleExpanderStyle}">
            <Grid Height="160">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Output area -->
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding RawConsole.Entries}"
                         Style="{StaticResource ConsoleListStyle}"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConsoleEntry}">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding Kind, Converter={StaticResource ConsoleKindToColor}}"
                                       FontFamily="Consolas" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Input row -->
                <DockPanel Grid.Row="1" Margin="4,4,4,4">
                    <Button DockPanel.Dock="Right" Content="{loc:Str Main_Clear}"
                            Command="{Binding RawConsole.ClearConsoleCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button DockPanel.Dock="Right" Content="{loc:Str Main_Send}"
                            Command="{Binding SendRawCommandCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" />
                    <Grid>
                        <TextBox x:Name="ConsoleInput"
                                 Text="{Binding RawConsole.InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ConsoleInputStyle}"
                                 FontFamily="Consolas"
                                 KeyDown="ConsoleInput_KeyDown"
                                 ToolTip="{loc:Str Main_ConsoleTip}" />
                        <!-- Placeholder: what goes here is the subcommand only; a pasted full line is trimmed -->
                        <TextBlock Text="{loc:Str Main_ConsolePlaceholder}"
                                   Margin="8,0,12,0" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource BrushMuted}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=ConsoleInput, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                </DockPanel>
            </Grid>
        </Expander>

        <!-- ── Action bar ── -->
        <Border Grid.Row="5" Style="{StaticResource ActionBarStyle}">
            <DockPanel Margin="8,6,8,6">
                <Button DockPanel.Dock="Right"
                        Content="{loc:Str Main_ExportLog}"
                        Command="{Binding ExportLogCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        ToolTip="{loc:Str Main_ExportLogTip}" />

                <Button DockPanel.Dock="Right"
                        Content="{loc:Str Main_CopyResults}"
                        Command="{Binding CopyResultsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        ToolTip="{loc:Str Main_CopyResultsTip}" />

                <Button DockPanel.Dock="Right"
                        Content="{loc:Str Main_Advanced}"
                        Command="{Binding ToggleRawConsoleCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0" />

                <!-- Run Tests — large, prominent -->
                <Button Content="{loc:Str Main_RunTests}"
                        DockPanel.Dock="Left"
                        Command="{Binding RunTestsCommand}"
                        Style="{StaticResource RunButtonStyle}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />

                <!-- Find my radio — sweeps the ticked COM ports with query-only probes -->
                <Button DockPanel.Dock="Left"
                        Content="{loc:Str Main_FindRadio}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                        Click="FindRadio_Click"
                        ToolTip="{loc:Str Main_FindRadioTip}" />

                <!-- Scan — PC-side checks, no radio needed. Never runs on its own. -->
                <Button Content="{loc:Str Main_Scan}"
                        Command="{Binding ScanEnvironmentCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="8,0,0,0"
                        ToolTip="{loc:Str Main_ScanTip}" />
            </DockPanel>
        </Border>

        <!-- ── Status strip ── -->
        <Border Grid.Row="6" Style="{StaticResource StatusStripStyle}">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource StatusStripTextStyle}" />
        </Border>

    </Grid>
    </DockPanel>
</Window>
