<Window x:Class="RigCheck.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RigCheck.Localization"
        xmlns:app="clr-namespace:RigCheck"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushForeground}">

    <!--
        Branding and version. Links open in the browser and carry the
        external-link glyph. The logo is the placeholder icon until final
        artwork exists; it is also where the easter egg will hook in.
    -->

    <StackPanel Margin="24,20,24,16">

        <DockPanel Margin="0,0,0,12">
            <Image x:Name="Logo" DockPanel.Dock="Left"
                   Source="pack://application:,,,/Assets/rigcheck.ico"
                   Width="48" Height="48" Margin="0,0,16,0"
                   VerticalAlignment="Top" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static app:BrandingInfo.FullName}"
                           FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static app:BrandingInfo.Tagline}"
                           Foreground="{StaticResource BrushMuted}" FontStyle="Italic" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="VersionText" Margin="0,0,0,2" />
        <TextBlock x:Name="DeveloperText" Foreground="{StaticResource BrushMuted}" />
        <TextBlock Text="{x:Static app:BrandingInfo.Company}"
                   Foreground="{StaticResource BrushMuted}" />
        <TextBlock Text="{x:Static app:BrandingInfo.Copyright}"
                   Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12" />

        <TextBlock x:Name="LicenseText" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Style="{StaticResource LinkButtonStyle}" Padding="0,0,16,0"
                    Tag="{x:Static app:BrandingInfo.AppUrl}" Click="Link_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Str About_Website}" />
                    <TextBlock Style="{StaticResource ExternalLinkIconStyle}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LinkButtonStyle}" Padding="0,0,16,0"
                    Tag="{x:Static app:BrandingInfo.GitHubRepo}" Click="Link_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Str About_SourceCode}" />
                    <TextBlock Style="{StaticResource ExternalLinkIconStyle}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LinkButtonStyle}" Padding="0"
                    Tag="{x:Static app:BrandingInfo.LicenseUrl}" Click="Link_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static app:BrandingInfo.License}" />
                    <TextBlock Style="{StaticResource ExternalLinkIconStyle}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Button Content="{loc:Str Common_Close}"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" MinWidth="90"
                IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
