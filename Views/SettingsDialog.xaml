<Window x:Class="RigCheck.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RigCheck.Localization"
        Title="{loc:Str Settings_Title}"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushForeground}">

    <!-- Placeholder until there are settings to show. -->

    <StackPanel Margin="24,20,24,16">
        <TextBlock Text="{loc:Str Settings_ComingSoon}"
                   Foreground="{StaticResource BrushMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,20" />

        <Button Content="{loc:Str Common_Close}"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" MinWidth="90"
                IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
