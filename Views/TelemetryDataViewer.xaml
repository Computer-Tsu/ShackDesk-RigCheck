<Window x:Class="RigCheck.Views.TelemetryDataViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RigCheck.Localization"
        Title="{loc:Str DataViewer_Title}"
        Width="640" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushForeground}">

    <!-- Read-only view of every report written locally, so "what is sent" is verifiable. -->

    <DockPanel Margin="16">
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap"
                   Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,0,0,10" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="{loc:Str DataViewer_Clear}"
                    Style="{StaticResource SecondaryButtonStyle}" Click="Clear_Click" />
            <Button Content="{loc:Str Common_Close}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" MinWidth="90"
                    IsDefault="True" IsCancel="True" />
        </DockPanel>

        <TextBox x:Name="ReportsText"
                 Style="{StaticResource TextBoxStyle}"
                 Background="{StaticResource BrushConsole}"
                 FontFamily="Consolas" FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalAlignment="Stretch" />
    </DockPanel>
</Window>
